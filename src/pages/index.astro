---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import { publishedPosts } from '../lib';

const posts = (await publishedPosts()).slice(0, 12);
---

<Base title="renard.cool" description="Photographie, faune et musique. Le carnet d'un renard.">
  <section class="intro">
    <h1>Un renard, un appareil photo, quelques notes.</h1>
    <p class="muted">
      Photographies, rencontres avec la faune et compositions musicales. Pas de rubrique conseils,
      pas de newsletter. Juste ce que je vois et ce que j'entends.
    </p>
  </section>
  <PostGrid posts={posts} />
</Base>

<style>
  .intro {
    max-width: var(--measure);
    margin-bottom: 3.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 1rem;
  }

  p {
    font-size: 1.1rem;
  }
</style>
