---
import Base from '../layouts/Base.astro';
import PlateList from '../components/PlateList.astro';
import { publishedPosts } from '../lib';

const posts = await publishedPosts();
---

<Base title="renard.cool" description="Photographies, faune et musique. Le carnet d'un renard.">
  <section class="title-page">
    <h1>renard.cool</h1>
    <p class="subtitle">Photographies, faune &amp; musique</p>
    <span class="fleuron" aria-hidden="true"></span>
  </section>

  <PlateList posts={posts} showCategory />
</Base>

<style>
  .title-page {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    letter-spacing: 0.02em;
  }

  .subtitle {
    font-style: italic;
    font-size: 1.3rem;
    margin: 0.25rem 0 0;
  }
</style>
