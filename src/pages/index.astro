---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { publishedPosts } from '../lib';

const posts = await publishedPosts();
const latest = posts[0];
---

<Base title="renard.cool" description="Photographies, faune et musique. Le carnet d'un renard.">
  <section class="title-page">
    <h1>renard.cool</h1>
    <p class="subtitle">Photographies, faune &amp; musique</p>
    <span class="fleuron" aria-hidden="true"></span>
    <p class="soft">Ce que je vois dehors, et ce que j'entends en rentrant.</p>
  </section>

  {
    latest && (
      <a href={`/${latest.id}`} class="frontispiece">
        <Plate src={latest.data.cover} alt={latest.data.coverAlt} caption={latest.data.title} loading="eager" />
      </a>
    )
  }

  <TableOfContents posts={posts} />
</Base>

<style>
  .title-page {
    text-align: center;
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    letter-spacing: 0.02em;
  }

  .subtitle {
    font-style: italic;
    font-size: 1.3rem;
    margin: 0.25rem 0 0;
  }

  .soft {
    margin: 0;
  }

  .frontispiece {
    display: block;
    max-width: 40rem;
    margin-inline: auto;
  }

  .frontispiece:hover :global(figcaption) {
    color: var(--red);
  }
</style>
