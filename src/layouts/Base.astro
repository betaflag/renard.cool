---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const pageTitle = title === 'renard.cool' ? title : `${title} · renard.cool`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="renard.cool" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=IM+Fell+English+SC&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      !isHome && (
        <header class="page">
          <a href="/" class="sc">renard.cool</a>
        </header>
      )
    }
    <main class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  header {
    padding-top: 1.25rem;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
  }

  header a:hover {
    color: var(--red);
  }

  main {
    padding-block: 4rem 5rem;
  }
</style>
