---
// Full-screen viewer for the plates of one page. Opens on click of any
// [data-zoom] link; arrows move between plates, Escape or a click closes.
---

<dialog class="lightbox" aria-label="Photo en plein écran">
  <button type="button" class="close sc" data-close>Fermer</button>
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <p class="hint sc" aria-hidden="true">Flèches pour changer de planche, Échap pour fermer</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-zoom]')];
  if (dialog && links.length > 0) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      const thumb = link.querySelector('img');
      img.src = link.href;
      img.alt = thumb?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      if (!dialog.open) dialog.showModal();
    };

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        show(index);
      });
    });

    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(current + 1);
      if (event.key === 'ArrowLeft') show(current - 1);
    });
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
    });

    let touchStartX = 0;
    dialog.addEventListener('touchstart', (event) => {
      touchStartX = event.changedTouches[0].clientX;
    }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const delta = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) < 50) return;
      event.preventDefault();
      swiped = true;
      show(delta < 0 ? current + 1 : current - 1);
    });
    let swiped = false;
    dialog.addEventListener('click', (event) => {
      if (swiped) {
        swiped = false;
        event.stopImmediatePropagation();
      }
    }, true);
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    cursor: zoom-out;
  }

  .lightbox::backdrop {
    background: var(--paper);
  }

  figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2.5rem 1.5rem 3rem;
  }

  img {
    max-width: 100%;
    max-height: calc(100vh - 7rem);
    max-height: calc(100dvh - 7rem);
    width: auto;
    height: auto;
    border: 1px solid var(--ink);
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  figcaption {
    font-style: italic;
    color: var(--ink-soft);
    text-align: center;
  }

  figcaption:empty {
    display: none;
  }

  .close {
    position: absolute;
    top: max(0.5rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    min-height: 44px;
    background: none;
    border: 0;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-family: var(--book-sc);
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .close:hover,
  .close:focus-visible {
    color: var(--red);
    outline: none;
  }

  .hint {
    position: absolute;
    bottom: 0.75rem;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  @media (max-width: 760px), (hover: none) {
    .hint {
      display: none;
    }

    figure {
      padding: 3.5rem 0.75rem 2rem;
    }
  }
</style>
