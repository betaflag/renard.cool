---
import Plate from './Plate.astro';
import { CATEGORIES } from '../content.config';
import { formatDate, type Post } from '../lib';

interface Props {
  posts: Post[];
  showCategory?: boolean;
}

const { posts, showCategory = false } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty soft">Ce chapitre est encore blanc.</p>
  ) : (
    <ol class="plates">
      {posts.map((post) => (
        <li>
          <a href={`/${post.id}`}>
            <Plate src={post.data.cover} alt={post.data.coverAlt} />
            {showCategory && <p class="sc chapter">{CATEGORIES[post.data.category]}</p>}
            <h2>{post.data.title}</h2>
            <p class="soft">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.location && <span>, {post.data.location}</span>}
            </p>
            <p class="desc">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ol>
  )
}

<style>
  .empty {
    text-align: center;
    font-style: italic;
  }

  .plates {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4rem;
  }

  li {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .chapter {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .chapter + h2 {
    margin-top: 0.25rem;
  }

  h2 {
    font-size: 1.6rem;
    margin-top: 1.5rem;
  }

  a:hover h2 {
    color: var(--red);
  }

  p {
    margin: 0.25rem 0 0;
  }

  .soft {
    font-size: 0.95rem;
    font-style: italic;
  }

  .desc {
    margin-top: 0.5rem;
  }

  @media (max-width: 760px) {
    .plates {
      gap: 3rem;
    }

    h2 {
      font-size: 1.4rem;
      margin-top: 1.1rem;
    }
  }
</style>
