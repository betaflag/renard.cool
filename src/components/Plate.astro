---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  loading?: 'eager' | 'lazy';
  zoomable?: boolean;
}

const { src, alt, caption, loading = 'lazy', zoomable = false } = Astro.props;
const full = zoomable ? await getImage({ src, width: 2400, quality: 85, format: 'webp' }) : null;
---

<figure class="plate">
  {
    full ? (
      <a href={full.src} class="zoom" data-zoom data-caption={caption}>
        <Image src={src} alt={alt} widths={[700, 1200, 1800]} sizes="(max-width: 760px) 100vw, 52rem" loading={loading} />
      </a>
    ) : (
      <Image src={src} alt={alt} widths={[700, 1200, 1800]} sizes="(max-width: 760px) 100vw, 52rem" loading={loading} />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .zoom {
    display: block;
    cursor: zoom-in;
  }
</style>
