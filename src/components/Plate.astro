---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, caption, loading = 'lazy' } = Astro.props;
---

<figure class="plate">
  <Image src={src} alt={alt} widths={[700, 1200, 1800]} sizes="(max-width: 760px) 100vw, 52rem" loading={loading} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
