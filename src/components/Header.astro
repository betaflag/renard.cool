---
import { CATEGORIES } from '../content.config';

interface Props {
  runningHead?: string;
}

const { runningHead } = Astro.props;
const path = Astro.url.pathname;
const links = Object.entries(CATEGORIES).map(([slug, label]) => ({
  href: `/${slug}`,
  label,
  active: path.startsWith(`/${slug}`),
}));
---

<header class="page">
  <div class="running sc">
    <a href="/" aria-label="Accueil">renard.cool</a>
    {runningHead && <span class="soft">{runningHead}</span>}
  </div>
  <nav aria-label="Chapitres" class="sc">
    {links.map((l, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">·</span>}
        <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
      </>
    ))}
  </nav>
</header>

<style>
  header {
    padding-top: 1.25rem;
    font-size: 0.95rem;
  }

  .running {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  nav {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
  }

  .sep {
    color: var(--rule);
  }

  nav a[aria-current='page'] {
    color: var(--red);
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
