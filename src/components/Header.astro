---
import { CATEGORIES } from '../content.config';

const path = Astro.url.pathname;
const links = Object.entries(CATEGORIES).map(([slug, label]) => ({
  href: `/${slug}`,
  label,
  active: path.startsWith(`/${slug}`),
}));
---

<header class="wrap">
  <a href="/" class="brand" aria-label="Accueil">renard<span>.cool</span></a>
  <nav aria-label="Sections">
    {links.map((l) => (
      <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 500;
  }

  .brand span {
    color: var(--accent);
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  nav a {
    color: var(--muted);
    padding-bottom: 0.15rem;
    border-bottom: 1px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
    border-color: var(--accent);
  }

  @media (max-width: 480px) {
    header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
