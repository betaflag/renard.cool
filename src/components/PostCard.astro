---
import { Image } from 'astro:assets';
import { CATEGORIES } from '../content.config';
import { formatDate, type Post } from '../lib';

interface Props {
  post: Post;
  showCategory?: boolean;
}

const { post, showCategory = true } = Astro.props;
const { title, description, pubDate, category, cover, coverAlt } = post.data;
---

<article>
  <a href={`/${post.id}`}>
    <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" loading="lazy" />
    <div class="meta">
      {showCategory && <span class="eyebrow">{CATEGORIES[category]}</span>}
      <time class="muted" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </div>
    <h2>{title}</h2>
    <p class="muted">{description}</p>
  </a>
</article>

<style>
  article img {
    aspect-ratio: 3 / 2;
    object-fit: cover;
    width: 100%;
    border-radius: 4px;
    background: var(--surface);
  }

  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.8rem;
    margin: 1rem 0 0.4rem;
  }

  h2 {
    font-size: 1.35rem;
  }

  p {
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
  }

  a:hover h2 {
    color: var(--accent);
  }
</style>
